# ══════════════════════════════════════════════════════════
# EchoForge — .gitignore
# ══════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ── Sanal Ortamlar ────────────────────────────────────────
.venv/
.venv_fish/
venv/
env/

# ── Uygulama Verileri (büyük / kişisel) ──────────────────
voice_files/
reference_voices/
output/
settings.json

# ── Model Dosyaları ───────────────────────────────────────
# Modeller D:\Ses_Modelleri veya ~/ses_modelleri altında,
# repoya eklenmemeli
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# ── HuggingFace / Ollama Cache ────────────────────────────
.cache/
hf_cache/

# ── IDE / Editör ──────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Log / Geçici ──────────────────────────────────────────
*.log
_chunks_tmp/
*.tmp
